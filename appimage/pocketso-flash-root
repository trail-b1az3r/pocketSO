#!/usr/bin/env python3
"""Root-only raw ISO writer. Called through pkexec; validates the target again."""
from __future__ import annotations
import json, os, re, subprocess, sys
from pathlib import Path

def output(args):
    return subprocess.run(args, check=True, capture_output=True, text=True).stdout.strip()

def disk_for(source):
    if not source:
        return set()
    source = source.split("[", 1)[0]
    try:
        rows = output(["lsblk", "-s", "-n", "-p", "-o", "NAME,TYPE", source])
    except (OSError, subprocess.CalledProcessError):
        return set()
    return {os.path.realpath(row.split()[0]) for row in rows.splitlines()
            if len(row.split()) == 2 and row.split()[1] == "disk"}

def main():
    if os.geteuid() != 0:
        print("ERROR: administrator privileges are required.")
        return 1
    if len(sys.argv) != 4:
        print("ERROR: invalid arguments.")
        return 2
    iso, target, confirmation = sys.argv[1:]
    iso_path = Path(iso).resolve()
    if not iso_path.is_file() or iso_path.suffix.lower() != ".iso":
        print("ERROR: ISO file is missing or invalid.")
        return 2
    if target != confirmation or not target.startswith("/dev/"):
        print("ERROR: device confirmation does not match.")
        return 2
    target = os.path.realpath(target)
    info = json.loads(output(["lsblk", "-J", "-b", "-d", "-o", "NAME,PATH,TYPE,SIZE,TRAN,RM,RO", target]))["blockdevices"]
    if len(info) != 1 or info[0].get("type") != "disk":
        print("ERROR: select a whole USB disk, not a partition.")
        return 2
    device = info[0]
    if device.get("tran") != "usb" and str(device.get("rm")).lower() not in ("1", "true"):
        print("ERROR: safety block: target is not identified as USB/removable.")
        return 2
    if str(device.get("ro")).lower() in ("1", "true"):
        print("ERROR: target is read-only.")
        return 2
    protected = set()
    for mount in ("/", "/boot", "/boot/efi", "/efi", "/home", "/var", "/usr", "/opt", "/srv", "/run/archiso/bootmnt"):
        try:
            protected |= disk_for(output(["findmnt", "-nro", "SOURCE", mount]))
        except (OSError, subprocess.CalledProcessError):
            pass
    if target in protected:
        print("ERROR: safety block: refusing to overwrite the running system disk.")
        return 2
    size, iso_size = int(device.get("size") or 0), iso_path.stat().st_size
    if iso_size <= 0 or iso_size > size:
        print("ERROR: ISO does not fit on the selected USB drive.")
        return 2
    print(f"Target: {target} ({size} bytes)", flush=True)
    print("Unmounting mounted partitions on the USB drive…", flush=True)
    partitions = output(["lsblk", "-lnpo", "NAME", target]).splitlines()[1:]
    for partition in partitions:
        subprocess.run(["umount", partition], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    mounts = output(["lsblk", "-nrpo", "MOUNTPOINT", target])
    if any(line.strip() for line in mounts.splitlines()):
        print("ERROR: one or more USB partitions remain mounted; nothing was written.")
        return 2
    print("Writing ISO. Do not unplug the USB drive.", flush=True)
    process = subprocess.Popen(["dd", f"if={iso_path}", f"of={target}", "bs=4M", "status=progress", "conv=fsync"],
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, bufsize=1)
    assert process.stderr is not None
    buffer = ""
    while True:
        char = process.stderr.read(1)
        if not char:
            break
        if char in "\r\n":
            line = buffer.strip()
            buffer = ""
            if line:
                print(line, flush=True)
                match = re.match(r"^(\d+)\s+bytes", line)
                if match:
                    percent = min(100, int(int(match.group(1)) * 100 / iso_size))
                    print(f"PROGRESS {percent}", flush=True)
        else:
            buffer += char
    if buffer.strip():
        print(buffer.strip(), flush=True)
    code = process.wait()
    if code:
        print(f"ERROR: dd exited with status {code}.", flush=True)
        return code
    subprocess.run(["sync"], check=True)
    print("SUCCESS: ISO written and disk cache synchronized.", flush=True)
    return 0

if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f"ERROR: {exc}", flush=True)
        raise SystemExit(1)
